# Staging environment template — LOCAL_STAGING_CONFIGURATION.
#
# Copy to .env.staging and fill in. .env.staging is git-ignored.
# NOTHING in this file is a usable secret. Every placeholder below is either empty or a
# refusal marker that the application rejects at startup.
#
#   cp .env.staging.example .env.staging
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # -> SESSION_SECRET
#   python -c "import secrets; print(secrets.token_urlsafe(24))"   # -> POSTGRES_PASSWORD

APP_ENV=staging

# --- Database ----------------------------------------------------------------------
# The database publishes no host port; these credentials are used only inside the
# compose network. Generate a unique password anyway — a shared or reused password is
# how a "local only" database ends up reachable after someone adds a port mapping.
POSTGRES_USER=dedunet_staging
POSTGRES_PASSWORD=
POSTGRES_DB=dedunet_staging

# --- Sessions ----------------------------------------------------------------------
# REQUIRED. The container refuses to start without it: manage.py check calls
# assert_configured(), and the entrypoint runs manage.py check before serving.
# Must be at least 32 characters and must not be the development default.
SESSION_SECRET=

# --- Legacy fixture admin API -------------------------------------------------------
# Distinct from the role-based administrator. The placeholder below is REFUSED by the
# fail-closed guard in every environment, which is why it is safe to ship here.
ADMIN_API_TOKEN=change-me

# --- Rate limiting ------------------------------------------------------------------
# Buckets are process-local, so staging runs exactly one API process and one worker.
# MULTI_REPLICA_DEPLOYMENT_BLOCKED_PENDING_SHARED_OR_GATEWAY_RATE_LIMITING
RATE_LIMIT_ENABLED=1
# Local staging has no trusted proxy chain. Do NOT raise this in anticipation of a
# hosted proxy; a future environment must determine and test its real chain first.
RATE_LIMIT_TRUSTED_PROXY_COUNT=0

# --- Demo data ----------------------------------------------------------------------
# Staging carries no demo customer, administrator, product or order.
SEED_DEMO_DATA=0

# --- Administrator bootstrap --------------------------------------------------------
# Used ONLY by the manual `manage.py create-admin` step, never by the entrypoint.
# Leave the password empty here; export it in the shell for the one command that needs
# it so it does not sit on disk:
#   docker compose -f docker-compose.staging.yml exec \
#     -e ADMIN_BOOTSTRAP_PASSWORD='...' api python manage.py create-admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Staging Administrator

# --- Storefront ---------------------------------------------------------------------
# Both loopback spellings are distinct origins to a browser.
CORS_ORIGINS=http://localhost:13080,http://127.0.0.1:13080
STORE_CURRENCY=EUR
DEFAULT_SHIPPING_MINOR_UNITS=890
FREE_SHIPPING_THRESHOLD_MINOR_UNITS=10000

# --- Ports --------------------------------------------------------------------------
# Deliberately different from development (18000/13000) so a staging stack and a dev
# stack can run side by side without one silently answering for the other.
API_PORT=18080
WEB_PORT=13080

# --- Not configured in staging ------------------------------------------------------
# SMTP, backups, DEDUNET product data and cloud deployment are later workstreams.
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Notifications ------------------------------------------------------------------
# Console until a real SMTP account exists. EXTERNAL_SMTP_DELIVERY_PENDING.
NOTIFICATION_CHANNEL=console
# Claim lease. A worker killed mid-send holds its claim for at most this long before
# another worker may recover the row. Must be longer than the slowest provider call.
NOTIFICATION_CLAIM_TTL_SECONDS=300
NOTIFICATION_MAX_ATTEMPTS=5
