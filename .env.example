APP_ENV=development
# SECURITY (SB-RISK-B5-001): this placeholder is refused outside APP_ENV=development.
# Set a unique high-entropy token before any shared or non-local use.
ADMIN_API_TOKEN=change-me
CORS_ORIGINS=http://localhost:13000,http://127.0.0.1:13000
STORE_CURRENCY=EUR
# Money contract SB-AR-B3-003: authoritative amounts are INTEGER MINOR UNITS.
# 890 = EUR 8.90 shipping; 10000 = EUR 100.00 free-shipping threshold.
# The legacy decimal variables DEFAULT_SHIPPING_EUR / FREE_SHIPPING_THRESHOLD_EUR are
# still read as an exact decimal string if the minor-unit variables are absent.
DEFAULT_SHIPPING_MINOR_UNITS=890
FREE_SHIPPING_THRESHOLD_MINOR_UNITS=10000
OPENAI_API_KEY=
OPENAI_MODEL=
API_PORT=18000
STOREFRONT_PORT=13000

# --- Database ---------------------------------------------------------------------
# PostgreSQL is the runtime database. Unit tests use in-memory SQLite and select it via
# COMMERCE_TEST_DATABASE_URL, never via DATABASE_URL, so exporting this cannot point the
# suite at a real database.
POSTGRES_USER=commerce
POSTGRES_PASSWORD=change-me-in-every-environment
POSTGRES_DB=commerce
DATABASE_URL=postgresql+psycopg://commerce:change-me-in-every-environment@db:5432/commerce

# Connection pool. Raised above the SQLAlchemy default because the concurrency test
# issues 20 simultaneous reservations.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Signs session tokens. The application REFUSES to start outside development without it.
SESSION_SECRET=

# Bounded wait for the database at container start, in attempts of 2 seconds each.
DB_WAIT_ATTEMPTS=30
