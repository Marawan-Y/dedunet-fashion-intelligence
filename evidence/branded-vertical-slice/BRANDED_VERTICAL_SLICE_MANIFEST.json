  "proxy_header_finding": {
    "component": "uvicorn 0.35.0 ProxyHeadersMiddleware",
    "mechanism": "Config defaults proxy_headers=True; forwarded_allow_ips=None resolves to os.environ.get('FORWARDED_ALLOW_IPS','127.0.0.1'); the middleware sets scope['client']=(header_value, 0) for a trusted peer BEFORE application code runs",
