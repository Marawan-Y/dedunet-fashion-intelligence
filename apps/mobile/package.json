{
  "name": "dedunet-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:web": "expo export --platform web",
    "deps:check": "expo install --check",
    "mutations": "node scripts/mutation_check.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.19",
    "expo-build-properties": "~56.0.25",
    "expo-image": "~56.0.11",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
