# DEDUNET consumer client — nginx configuration TEMPLATE.
#
# A template, not a plain conf, because the API upstream must be configurable per
# deployment without editing tracked source and without baking a host address into an
# image. The nginx entrypoint runs envsubst over /etc/nginx/templates/*.template at
# container start, restricted by NGINX_ENVSUBST_FILTER to the DEDUNET_ prefix — so
# nginx's own $uri, $host and $upstream variables are left alone.
#
server {
    listen       80;
    server_name  localhost;
    root   /usr/share/nginx/html;

    # nginx turns a relative redirect into an absolute URL built from $host, which DROPS
    # the published port: "/" would send a browser on :13080 to port 80. Keeping redirects
    # relative preserves whatever host and port the client actually used.
    absolute_redirect off;

    # THE HISTORY FALLBACK.
    #
    # This is the one thing real path routing requires of its host, and its absence is a
    # defect that appears ONLY on refresh and deep links — never while clicking around,
    # which is how it reaches production. /discover is not a file on disk; without this it
    # is a 404 the moment someone reloads the page they are looking at, or opens a link
    # someone sent them.
    #
    # The E2E suite reloads every route for exactly this reason.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed assets are immutable by construction: the content hash is in the filename, so
    # a changed file is a different URL and can never be served stale.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        # Declaring add_header above discards the server-level security headers for this
        # location. Re-stated here; see the file for why this is not optional.
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    # index.html must NEVER be cached. It is the document that names which hashed bundle to
    # load, so a stale copy pins a browser to an old build indefinitely — which is exactly
    # the class of "the fix is deployed but I still see the old page" defect that wastes an
    # afternoon before anyone suspects the cache.
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate" always;
        # EVERY route in this SPA is served from this file via the history fallback, so a
        # dropped header here is a dropped header on every document the site serves.
        include /etc/nginx/security-headers.conf;
    }

    # Generated brand artefacts. Emitted by scripts/brand/build_brand_package.py and copied
    # verbatim; not hashed, so they revalidate rather than being held.
    location ~ ^/(tokens\.generated\.css|brand\.generated\.js)$ {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }

    # SAME-ORIGIN API.
    #
    # The client calls /api/... on its own origin and nginx forwards it to the commerce
    # API. This is the production-like topology and it is preferred over widening the
    # API's CORS list for a new origin: the browser sees one origin, so there is no
    # preflight, no CORS entry to maintain, no cross-origin cookie or referrer difference,
    # and the client needs no absolute API base baked in at build time.
    #
    # proxy_pass carries NO trailing URI on purpose. With one, nginx would rewrite the
    # path and /api/v1/products would arrive as /v1/products; without one the original
    # request URI is passed through unchanged, which is what the API serves.
    location /api/ {
        proxy_pass http://${DEDUNET_API_UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The API ignores X-Forwarded-For unless it is explicitly told how many proxies to
        # trust, which is correct and is left alone here. The consequence is deliberate and
        # worth knowing: rate limiting keys on THIS container's address, so every client
        # behind this proxy shares one bucket.
        proxy_connect_timeout 5s;
        proxy_read_timeout   30s;

        # Never cache an API response at the edge; the client decides what is fresh.
        proxy_buffering off;
        add_header Cache-Control "no-store" always;

        # DELIBERATELY NOT including security-headers.conf here, and this is the one
        # location where that is correct.
        #
        # The API sets its OWN baseline security headers (app/main.py): nosniff,
        # X-Frame-Options DENY, and `Referrer-Policy: no-referrer` — which is STRICTER than
        # the document policy. nginx add_header appends rather than replaces, so including
        # the contract here emitted Referrer-Policy twice, and the Referrer Policy spec
        # takes the last valid value: the proxy would have quietly downgraded the API's
        # deliberate no-referrer to strict-origin-when-cross-origin.
        #
        # Measured, not assumed — it is what this location did before this comment replaced
        # the include. The upstream's headers pass through untouched; the exemption is
        # asserted in test_consumer_security_headers.py so it stays a decision rather than
        # an oversight.
    }

    # The administration portal keeps its own path on this origin, unchanged. It is a
    # separate surface with its own acceptance and ADR-0004 does not migrate it.
    location /admin {
        try_files $uri $uri/ /admin/index.html;
    }

    # The document security header contract. ONE definition, included rather than repeated,
    # so the four values cannot drift apart between the five places they must appear.
    #
    # This server-level include covers `location /` and `location /admin`, which declare no
    # add_header of their own. Every location that DOES declare one includes the file
    # again, because nginx would otherwise discard these silently.
    include /etc/nginx/security-headers.conf;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;
    gzip_min_length 1024;
}
